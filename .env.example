# Copy to .env.local for local development. Set the same values in Vercel.
# Both come from Supabase: Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Comma-separated Google accounts allowed to use the app.
ALLOWED_EMAILS=you@example.com

# Local only, for the scripts. Never add these to Vercel or commit them.
# Supabase: Project Settings > API Keys > Secret keys.
SUPABASE_SECRET_KEY=sb_secret_your_key
# Notion: an internal integration with access to the Activity Database.
NOTION_TOKEN=ntn_your_token
